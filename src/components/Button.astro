---
// Production Safeguard: Strict typing for component props
export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [x: string]: any;
}

const { href, variant = 'primary', type = 'button', class: className, ...rest } = Astro.props;

const Element = href ? 'a' : 'button';
const baseClasses = 'btn';
const variantClasses = `btn-${variant}`;
const combinedClasses = [baseClasses, variantClasses, className].filter(Boolean).join(' ');
---

<Element 
  href={href} 
  type={href ? undefined : type} 
  class={combinedClasses} 
  {...rest}
>
  <slot />
</Element>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    font-size: 1rem;
    font-weight: 600;
    font-family: var(--font-sans);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: all var(--transition-normal);
    border: 2px solid transparent;
    text-decoration: none;
    line-height: 1;
  }

  /* Focus Accessibility */
  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--bg-primary), 0 0 0 5px var(--brand-yellow-dark);
  }

  .btn:active {
    transform: scale(0.98);
  }

  .btn-primary {
    background-color: var(--brand-yellow);
    color: var(--text-primary);
    box-shadow: var(--shadow-yellow);
  }

  .btn-primary:hover {
    background-color: var(--brand-yellow-dark);
    box-shadow: var(--shadow-lg);
  }

  .btn-secondary {
    background-color: var(--bg-secondary);
    color: var(--text-primary);
  }

  .btn-secondary:hover {
    background-color: #e5e7eb;
  }

  .btn-outline {
    background-color: transparent;
    border-color: var(--brand-yellow);
    color: var(--text-primary);
  }

  .btn-outline:hover {
    background-color: var(--brand-yellow-light);
  }
</style>
