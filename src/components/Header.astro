---
import Button from './Button.astro';

// Production Safeguard: Get current path to highlight active nav link
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Products', href: '/products' },
  { name: 'About Us', href: '/about' },
  { name: 'Blog', href: '/blog' },
];
---

<header class="site-header">
  <div class="container header-container">
    <a href="/" class="logo">
      <span class="logo-text">School<span class="logo-accent"> & </span>Stuff</span>
    </a>

    <nav aria-label="Primary Navigation">
      <ul class="nav-list">
        {navLinks.map((link) => (
          <li>
            <a 
              href={link.href} 
              class={`nav-link ${currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) ? 'active' : ''}`}
              aria-current={currentPath === link.href ? 'page' : undefined}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <Button href="/products" variant="primary">Explore Products</Button>
    </div>
  </div>
</header>

<style>
  .site-header {
    background-color: var(--bg-primary);
    border-bottom: 1px solid var(--bg-secondary);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  .logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .logo-text {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.02em;
  }

  .logo-accent {
    color: var(--brand-yellow-dark);
  }

  .nav-list {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-1) 0;
    position: relative;
  }

  .nav-link:hover, .nav-link.active {
    color: var(--text-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--brand-yellow);
    border-radius: var(--radius-full);
  }

  .header-actions {
    display: flex;
    align-items: center;
  }

  @media (max-width: 768px) {
    .nav-list {
      display: none; /* Add mobile menu toggle for production */
    }
  }
</style>
