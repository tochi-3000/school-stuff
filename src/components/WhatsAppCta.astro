---
// Production Safeguard: Strict prop typing and input sanitization
export interface Props {
  phoneNumber?: string; // Standard format, e.g. "08100053846"
  internationalNumber?: string; // WhatsApp API format without +, e.g. "2348100053846"
  message?: string;
  label?: string;
  variant?: 'button' | 'compact' | 'banner';
}

const {
  phoneNumber = "0810 005 3846",
  internationalNumber = "2348100053846",
  message = "Hi! I have a question about setting up Google Business Profile for my shop in Abuja.",
  label = "Chat or Call on WhatsApp",
  variant = 'button',
} = Astro.props;

const encodedMessage = encodeURIComponent(message);
const whatsappUrl = `https://wa.me/${internationalNumber}?text=${encodedMessage}`;
const callUrl = `tel:+${internationalNumber}`;
---

{variant === 'button' && (
  <div class="whatsapp-cta-group">
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="whatsapp-btn"
      aria-label={`${label} at ${phoneNumber}`}
    >
      <svg class="whatsapp-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.696c1.001.572 1.83.875 2.806.875 3.18 0 5.767-2.586 5.768-5.766.001-3.18-2.585-5.758-5.768-5.758zm3.385 8.163c-.143.402-.833.743-1.15.789-.315.045-.72.062-2.128-.519-1.696-.701-2.776-2.427-2.861-2.54-.085-.114-.691-.919-.691-1.753 0-.834.437-1.246.593-1.417.155-.171.341-.214.455-.214.114 0 .228.001.328.006.105.006.246-.04.385.293.143.342.49 1.196.533 1.282.043.086.071.186.014.3-.057.114-.085.186-.171.286-.086.1-.18.223-.257.3-.086.086-.176.18-.076.352.1.171.444.733.953 1.186.656.584 1.21.765 1.382.851.171.086.271.071.371-.043.1-.114.428-.499.542-.671.114-.171.228-.143.385-.086.157.057.999.471 1.171.557.171.086.286.129.328.2.043.072.043.415-.1 1.017zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.174L2 22l4.981-1.306C8.423 21.533 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span>{label}</span>
    </a>
    <a href={callUrl} class="call-link" aria-label={`Direct call ${phoneNumber}`}>
      Call: <strong>{phoneNumber}</strong>
    </a>
  </div>
)}

{variant === 'compact' && (
  <a 
    href={whatsappUrl} 
    target="_blank" 
    rel="noopener noreferrer" 
    class="whatsapp-compact"
    aria-label={`${label} at ${phoneNumber}`}
  >
    <svg class="whatsapp-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.696c1.001.572 1.83.875 2.806.875 3.18 0 5.767-2.586 5.768-5.766.001-3.18-2.585-5.758-5.768-5.758zm3.385 8.163c-.143.402-.833.743-1.15.789-.315.045-.72.062-2.128-.519-1.696-.701-2.776-2.427-2.861-2.54-.085-.114-.691-.919-.691-1.753 0-.834.437-1.246.593-1.417.155-.171.341-.214.455-.214.114 0 .228.001.328.006.105.006.246-.04.385.293.143.342.49 1.196.533 1.282.043.086.071.186.014.3-.057.114-.085.186-.171.286-.086.1-.18.223-.257.3-.086.086-.176.18-.076.352.1.171.444.733.953 1.186.656.584 1.21.765 1.382.851.171.086.271.071.371-.043.1-.114.428-.499.542-.671.114-.171.228-.143.385-.086.157.057.999.471 1.171.557.171.086.286.129.328.2.043.072.043.415-.1 1.017zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.174L2 22l4.981-1.306C8.423 21.533 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
    </svg>
    <span>WhatsApp / Call: <strong>{phoneNumber}</strong></span>
  </a>
)}

{variant === 'banner' && (
  <div class="whatsapp-banner">
    <div class="banner-text">
      <h4>Have questions or need help setting up?</h4>
      <p>Ask us any question on <strong>{phoneNumber}</strong> or chat with our Abuja team directly on WhatsApp.</p>
    </div>
    <a 
      href={whatsappUrl} 
      target="_blank" 
      rel="noopener noreferrer" 
      class="whatsapp-btn"
      aria-label={`${label} at ${phoneNumber}`}
    >
      <svg class="whatsapp-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.592 2.654-.696c1.001.572 1.83.875 2.806.875 3.18 0 5.767-2.586 5.768-5.766.001-3.18-2.585-5.758-5.768-5.758zm3.385 8.163c-.143.402-.833.743-1.15.789-.315.045-.72.062-2.128-.519-1.696-.701-2.776-2.427-2.861-2.54-.085-.114-.691-.919-.691-1.753 0-.834.437-1.246.593-1.417.155-.171.341-.214.455-.214.114 0 .228.001.328.006.105.006.246-.04.385.293.143.342.49 1.196.533 1.282.043.086.071.186.014.3-.057.114-.085.186-.171.286-.086.1-.18.223-.257.3-.086.086-.176.18-.076.352.1.171.444.733.953 1.186.656.584 1.21.765 1.382.851.171.086.271.071.371-.043.1-.114.428-.499.542-.671.114-.171.228-.143.385-.086.157.057.999.471 1.171.557.171.086.286.129.328.2.043.072.043.415-.1 1.017zM12 2C6.477 2 2 6.477 2 12c0 1.891.526 3.66 1.438 5.174L2 22l4.981-1.306C8.423 21.533 10.15 22 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
      </svg>
      <span>Chat on WhatsApp</span>
    </a>
  </div>
)}

<style>
  .whatsapp-cta-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-3) 0;
  }

  .whatsapp-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: #25d366;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast), box-shadow var(--transition-fast);
    box-shadow: 0 4px 6px -1px rgba(37, 211, 102, 0.2);
  }

  .whatsapp-btn:hover {
    background-color: #1ebc57;
    transform: translateY(-2px);
    box-shadow: 0 6px 12px -2px rgba(37, 211, 102, 0.35);
  }

  .whatsapp-icon {
    flex-shrink: 0;
  }

  .call-link {
    font-size: 0.95rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid #e5e7eb;
    background: var(--bg-primary);
  }

  .call-link:hover {
    color: var(--text-primary);
    border-color: var(--brand-yellow-dark);
  }

  .whatsapp-compact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #128c7e;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: rgba(37, 211, 102, 0.1);
  }

  .whatsapp-compact:hover {
    background-color: rgba(37, 211, 102, 0.2);
  }

  .whatsapp-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    margin: var(--space-6) 0;
  }

  .banner-text h4 {
    margin: 0 0 0.25rem 0;
    font-size: 1.15rem;
    color: #14532d;
  }

  .banner-text p {
    margin: 0;
    font-size: 0.95rem;
    color: #166534;
  }

  @media (max-width: 640px) {
    .whatsapp-cta-group {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }

    .whatsapp-btn {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1rem;
      min-height: 48px;
      font-size: 1rem;
    }

    .call-link {
      width: 100%;
      text-align: center;
      padding: 0.75rem 1rem;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .whatsapp-banner {
      flex-direction: column;
      align-items: stretch;
      text-align: center;
      gap: 1rem;
    }

    .whatsapp-banner .whatsapp-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
