---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.slug }, props: { entry },
  }));
}

// 2. For your template, you can get the entry directly from the prop
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout 
  title={entry.data.title} 
  description={entry.data.description}
>
  <article class="blog-post">
    <header class="post-header">
      <div class="container text-center">
        <div class="post-meta animate-fade-in">
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span class="separator">&bull;</span>
          <span class="author">By {entry.data.author}</span>
        </div>
        <h1 class="post-title animate-fade-in" style="animation-delay: 0.1s">
          {entry.data.title}
        </h1>
        {entry.data.tags && (
          <div class="post-tags animate-fade-in" style="animation-delay: 0.2s">
            {entry.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="post-content">
      <div class="container prose animate-fade-in" style="animation-delay: 0.3s">
        <Content />
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    padding-bottom: var(--space-8);
  }

  .post-header {
    padding: var(--space-8) 0 var(--space-6) 0;
    background-color: var(--brand-yellow-light);
    border-bottom: 1px solid var(--brand-yellow);
    margin-bottom: var(--space-8);
  }

  .text-center {
    text-align: center;
  }

  .post-meta {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-yellow-darker);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .separator {
    margin: 0 var(--space-2);
    color: var(--text-secondary);
  }

  .post-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    color: var(--text-primary);
    max-width: 900px;
    margin: 0 auto var(--space-4) auto;
    line-height: 1.1;
  }

  .post-tags {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
  }

  .tag {
    background-color: var(--bg-primary);
    color: var(--brand-yellow-darker);
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    border: 1px solid var(--brand-yellow);
  }

  /* Prose Styling for Markdown Content */
  .post-content .prose {
    max-width: 768px;
    margin: 0 auto;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .post-content .prose :global(h1),
  .post-content .prose :global(h2),
  .post-content .prose :global(h3) {
    color: var(--text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .post-content .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .post-content .prose :global(a) {
    color: var(--brand-yellow-darker);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .post-content .prose :global(blockquote) {
    border-left: 4px solid var(--brand-yellow);
    padding-left: var(--space-4);
    margin-left: 0;
    font-style: italic;
    color: var(--text-primary);
    font-size: 1.25rem;
    background: var(--bg-secondary);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .post-content .prose :global(ul),
  .post-content .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-4);
  }

  .post-content .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-content .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }
</style>
