---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import WhatsAppCta from '../../components/WhatsAppCta.astro';

// 1. Generate a new path for every collection entry using entry.id
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map(entry => ({
    params: { slug: entry.id }, 
    props: { entry },
  }));
}

// 2. For your template, render entry using Astro 6 content loader API
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout 
  title={entry.data.title} 
  description={entry.data.description}
>
  <article class="blog-post">
    <header class="post-header">
      <div class="container text-center">
        <div class="post-meta animate-fade-in">
          <time datetime={entry.data.pubDate.toISOString()}>
            {entry.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span class="separator">&bull;</span>
          <span class="author">By {entry.data.author}</span>
        </div>
        <h1 class="post-title animate-fade-in" style="animation-delay: 0.1s">
          {entry.data.title}
        </h1>
        {entry.data.tags && (
          <div class="post-tags animate-fade-in" style="animation-delay: 0.2s">
            {entry.data.tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>
    </header>

    <div class="post-content">
      <div class="container prose animate-fade-in" style="animation-delay: 0.3s">
        <Content />

        <!-- Done-For-You Lead Generation Banner -->
        <div class="post-dfy-card">
          <div class="dfy-header-pill">Done-For-You Setup in Abuja</div>
          <h3>Setting up a shop or office in Abuja? Let our local team handle it.</h3>
          <p>
            Avoid video verification rejections, plaza duplicate address suspensions, and automated support queues. Our Abuja local SEO team handles your verification, setup, and Google Maps ranking.
          </p>
          <WhatsAppCta 
            label="Call or WhatsApp: 0810 005 3846"
            message={`Hi! I read your article "${entry.data.title}" and would like to ask about setting up Google Business Profile for my Abuja business.`}
            variant="button"
          />
          <div class="dfy-link-wrap">
            <a href="/services/google-business-profile-abuja" class="dfy-service-link">
              Explore our Abuja Done-For-You Setup Service &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>

<style>
  .blog-post {
    padding-bottom: var(--space-8);
  }

  .post-header {
    padding: var(--space-8) 0 var(--space-6) 0;
    background-color: var(--brand-yellow-light);
    border-bottom: 1px solid var(--brand-yellow);
    margin-bottom: var(--space-8);
  }

  .text-center {
    text-align: center;
  }

  .post-meta {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--brand-yellow-darker);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .separator {
    margin: 0 var(--space-2);
    color: var(--text-secondary);
  }

  .post-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    color: var(--text-primary);
    max-width: 900px;
    margin: 0 auto var(--space-4) auto;
    line-height: 1.1;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
    max-width: 100%;
    margin: 0 auto;
    padding: 0 var(--space-2);
  }

  .tag {
    background-color: var(--bg-primary);
    color: var(--brand-yellow-darker);
    font-size: 0.85rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    font-weight: 600;
    border: 1px solid var(--brand-yellow);
    white-space: nowrap;
  }

  /* Prose Styling for Markdown Content */
  .post-content .prose {
    max-width: 768px;
    margin: 0 auto;
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .post-content .prose :global(h1),
  .post-content .prose :global(h2),
  .post-content .prose :global(h3) {
    color: var(--text-primary);
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .post-content .prose :global(p) {
    margin-bottom: var(--space-4);
  }

  .post-content .prose :global(a) {
    color: var(--brand-yellow-darker);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
  }

  .post-content .prose :global(blockquote) {
    border-left: 4px solid var(--brand-yellow);
    padding-left: var(--space-4);
    margin-left: 0;
    font-style: italic;
    color: var(--text-primary);
    font-size: 1.25rem;
    background: var(--bg-secondary);
    padding: var(--space-4);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  .post-content .prose :global(ul),
  .post-content .prose :global(ol) {
    margin-bottom: var(--space-4);
    padding-left: var(--space-4);
  }

  .post-content .prose :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-content .prose :global(strong) {
    color: var(--text-primary);
    font-weight: 700;
  }

  .post-dfy-card {
    margin-top: var(--space-12);
    padding: var(--space-8);
    background: linear-gradient(135deg, #fffdf0 0%, #fef9c3 100%);
    border: 2px solid var(--brand-yellow);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px -5px rgba(250, 204, 21, 0.25);
  }

  .dfy-header-pill {
    display: inline-block;
    background: var(--brand-yellow-darker);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .post-dfy-card h3 {
    margin-top: 0 !important;
    font-size: 1.5rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .post-dfy-card p {
    color: var(--text-secondary);
    font-size: 1.05rem;
    margin-bottom: var(--space-4);
  }

  .dfy-link-wrap {
    margin-top: var(--space-3);
  }

  .dfy-service-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary) !important;
    text-decoration: underline !important;
    text-underline-offset: 4px;
  }

  .dfy-service-link:hover {
    color: var(--brand-yellow-darker) !important;
  }

  @media (max-width: 768px) {
    .post-header {
      padding: var(--space-6) 0 var(--space-4) 0;
      margin-bottom: var(--space-4);
    }

    .post-title {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
      line-height: 1.2;
      margin-bottom: var(--space-3);
    }

    .post-tags {
      gap: 0.4rem 0.5rem;
      padding: 0 0.25rem;
    }

    .tag {
      font-size: 0.78rem;
      padding: 0.2rem 0.55rem;
    }

    .post-content .prose {
      font-size: 1.05rem;
      line-height: 1.7;
      word-break: break-word;
      overflow-wrap: break-word;
    }

    .post-dfy-card {
      margin-top: var(--space-8);
      padding: 1.25rem;
    }

    .post-dfy-card h3 {
      font-size: 1.25rem;
    }

    .post-dfy-card p {
      font-size: 0.95rem;
    }

    .dfy-service-link {
      display: inline-block;
      text-align: center;
      width: 100%;
      padding: 0.5rem 0;
    }
  }
</style>
