---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// SEO Constants
const title = "Blog | School and Stuff";
const description = "Read the latest news, updates, and thoughts on the future of EdTech from the School and Stuff team.";

// Fetch all blog posts and sort by date descending
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={title} description={description}>
  <section class="blog-header">
    <div class="container text-center">
      <h1 class="page-title animate-fade-in">Our Blog</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        Insights and updates on EdTech, Seer SaaS, and learning.
      </p>
    </div>
  </section>

  <section class="blog-list-section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post, index) => (
          <article class="blog-card animate-fade-in" style={`animation-delay: ${0.2 + (index * 0.1)}s`}>
            <div class="blog-content">
              <div class="blog-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>
              <h2 class="blog-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h2>
              <p class="blog-desc">{post.data.description}</p>
              
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="blog-tags">
                  {post.data.tags.map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
              
              <a href={`/blog/${post.slug}`} class="read-more">
                Read Article <span aria-hidden="true" class="arrow">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-header {
    padding: var(--space-8) 0 var(--space-4) 0;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid #e5e7eb;
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
  }

  .blog-list-section {
    padding: var(--space-8) 0;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: var(--space-6);
  }

  .blog-card {
    background: var(--bg-primary);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
    display: flex;
    flex-direction: column;
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--brand-yellow);
  }

  .blog-meta {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-2);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .blog-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-2);
  }

  .blog-title a {
    color: var(--text-primary);
  }

  .blog-title a:hover {
    color: var(--brand-yellow-darker);
  }

  .blog-desc {
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    flex: 1;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .tag {
    background-color: var(--brand-yellow-light);
    color: var(--brand-yellow-darker);
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .read-more {
    font-weight: 600;
    color: var(--brand-yellow-darker);
    display: inline-flex;
    align-items: center;
  }

  .read-more:hover .arrow {
    transform: translateX(4px);
  }

  .arrow {
    display: inline-block;
    margin-left: var(--space-1);
    transition: transform var(--transition-fast);
  }
</style>
