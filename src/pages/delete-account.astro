---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const title = "Delete Account | Seer";
const description = "Learn how to request an account deletion on Seer: Exam Prediction and Simulation Platform.";
---

<Layout title={title} description={description}>
  <section class="account-action-header">
    <div class="container text-center">
      <h1 class="page-title animate-fade-in">Seer: Exam Prediction and Simulation</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        Account Deletion Guide
      </p>
    </div>
  </section>

  <section class="account-action-content">
    <div class="container">
      <div class="content-grid">
        
        <!-- Instructions Side -->
        <div class="instructions-side animate-fade-in" style="animation-delay: 0.2s">
          <h2>How to Delete Your Account</h2>
          <p class="intro-text">
            We're sorry to see you go! If you no longer need our exam prediction engine, you can permanently delete your account and all associated data by following these simple steps within the Seer app:
          </p>
          
          <ol class="steps-list">
            <li>
              <strong>Navigate to your Profile:</strong> 
              Open the Seer app on your device and navigate to your "My Profile" screen directly from the main dashboard.
            </li>
            <li>
              <strong>Request Deletion:</strong> 
              Scroll to the bottom of the profile settings and click on the red <em>"Request Account Deletion"</em> button.
            </li>
            <li>
              <strong>Grace Period:</strong> 
              Your account will be queued for deletion. It will be <strong>automatically and permanently deleted within 7 days</strong>, unless you log back in to cancel the request.
            </li>
          </ol>
          
          <div class="support-notice">
            <p>Need help? Contact our support team at <strong>support@school-and-stuff.com</strong>.</p>
          </div>
        </div>
        
        <!-- Image Mockup Side -->
        <div class="image-side animate-fade-in" style="animation-delay: 0.3s">
          <div class="image-wrapper">
            <img 
              src="/delete-account-mockup.png" 
              alt="Mockup of the Seer profile screen showing the Request Account Deletion button" 
              class="mockup-img"
              width="1024"
              height="1024"
            />
            <div class="image-caption">Example: Seer "My Profile" Screen</div>
          </div>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .account-action-header {
    padding: var(--space-8) 0 var(--space-4) 0;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid #e5e7eb;
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin-bottom: var(--space-2);
    color: var(--brand-yellow-darker);
  }

  .page-subtitle {
    font-size: 1.5rem;
    color: var(--text-primary);
    font-weight: 700;
  }

  .account-action-content {
    padding: var(--space-8) 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .instructions-side h2 {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
    border-bottom: 2px solid var(--brand-yellow);
    display: inline-block;
    padding-bottom: var(--space-1);
  }

  .intro-text {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }

  .steps-list {
    counter-reset: custom-counter;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .steps-list li {
    position: relative;
    padding-left: 3.5rem;
    margin-bottom: var(--space-6);
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .steps-list li::before {
    counter-increment: custom-counter;
    content: counter(custom-counter);
    position: absolute;
    left: 0;
    top: -4px;
    width: 2.5rem;
    height: 2.5rem;
    background-color: var(--brand-yellow-light);
    color: var(--brand-yellow-darker);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.25rem;
    border: 2px solid var(--brand-yellow);
  }

  .steps-list strong {
    color: var(--text-primary);
    display: block;
    margin-bottom: var(--space-1);
  }

  .support-notice {
    background-color: var(--bg-secondary);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border-left: 4px solid var(--text-secondary);
    margin-top: var(--space-8);
  }

  .support-notice p {
    margin: 0;
    color: var(--text-secondary);
  }

  .image-wrapper {
    background-color: var(--bg-secondary);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    box-shadow: var(--shadow-md);
    border: 1px solid #e5e7eb;
  }

  .mockup-img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
  }

  .image-caption {
    text-align: center;
    margin-top: var(--space-3);
    font-size: 0.9rem;
    color: var(--text-secondary);
    font-style: italic;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
    
    .image-side {
      order: -1;
    }
  }
</style>
