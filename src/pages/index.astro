---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

// SEO Constants for Production
const title = "Make Learning Fun | School and Stuff";
const description = "Discover Seer SaaS and physical EdTech products designed to make learning engaging and easy for everyone.";
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-container">
      <div class="hero-content animate-fade-in">
        <h1 class="hero-title">
          <span class="highlight">Seer</span> - Exam simulation
        </h1>
        <p class="hero-subtitle">
          We combine cutting-edge EdTech like Seer SaaS with interactive physical products to transform the educational experience.
        </p>
        <div class="hero-actions">
          <Button href="/products" variant="primary">Explore Our Products</Button>
          <Button href="/about" variant="secondary">Our Mission</Button>
        </div>
      </div>
      
      <div class="hero-visual animate-fade-in" style="animation-delay: 0.2s">
        <div class="app-screenshot-wrapper">
          <img 
            src="/app-screenshot.jpg" 
            alt="Seer App Dashboard" 
            style="max-width: 320px; border-radius: 24px; box-shadow: var(--shadow-lg);" 
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="container features-container">
      <div class="feature-item">
        <div class="feature-icon">✨</div>
        <h2 class="feature-title">Interactive SaaS</h2>
        <p>Seer makes learning dynamic and tracks progress in real-time.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon">🎒</div>
        <h2 class="feature-title">Physical Gear</h2>
        <p>Tangible products that bring educational concepts into the real world.</p>
      </div>
      <div class="feature-item">
        <div class="feature-icon">🔒</div>
        <h2 class="feature-title">Secure & Scalable</h2>
        <p>Built with privacy in mind. Enterprise-grade security for student data.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero Section Styles */
  .hero {
    padding: var(--space-12) 0 var(--space-8) 0;
    position: relative;
    overflow: hidden;
    background: linear-gradient(to bottom, var(--brand-yellow-light) 0%, var(--bg-primary) 100%);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero-title {
    font-size: clamp(3rem, 5vw, 4.5rem);
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }

  .highlight {
    color: var(--brand-yellow-darker);
    position: relative;
    display: inline-block;
  }

  .highlight::after {
    content: '';
    position: absolute;
    bottom: 8px;
    left: 0;
    width: 100%;
    height: 12px;
    background-color: var(--brand-yellow);
    z-index: -1;
    border-radius: var(--radius-sm);
    opacity: 0.6;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 500px;
    margin-bottom: var(--space-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
  }

  /* Hero Visual Styles (Glassmorphism) */
  .hero-visual {
    position: relative;
    height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .glass-orb {
    position: absolute;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, var(--brand-yellow) 0%, transparent 70%);
    border-radius: var(--radius-full);
    filter: blur(40px);
    opacity: 0.8;
    z-index: 0;
  }

  .glass-card {
    position: relative;
    z-index: 1;
    width: 320px;
    background: rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }

  .card-header {
    background: rgba(255, 255, 255, 0.5);
    padding: var(--space-2);
    display: flex;
    gap: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: var(--radius-full);
  }
  .dot.red { background-color: #ef4444; }
  .dot.yellow { background-color: #facc15; }
  .dot.green { background-color: #10b981; }

  .card-body {
    padding: var(--space-4);
  }

  .card-body h3 {
    font-size: 1.1rem;
    margin-bottom: var(--space-3);
  }

  .skeleton-bar {
    height: 12px;
    background: rgba(0, 0, 0, 0.1);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
  }

  /* Features Section */
  .features {
    padding: var(--space-8) 0;
  }

  .features-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .feature-item {
    background-color: var(--bg-secondary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-normal);
  }

  .feature-item:hover {
    transform: translateY(-5px);
  }

  .feature-icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }

  .feature-title {
    font-size: 1.25rem;
  }

  @media (max-width: 900px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero-subtitle {
      margin: 0 auto var(--space-6) auto;
    }
    .hero-actions {
      justify-content: center;
    }
    .features-container {
      grid-template-columns: 1fr;
    }
  }
</style>
