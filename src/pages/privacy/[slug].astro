---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'seer' },
      props: { appName: 'Seer', appIcon: '🔮', appType: 'Exam Simulation' }
    },
    {
      params: { slug: 'geo' },
      props: { appName: 'Geo', appIcon: '🌐', appType: 'Farm & Area Measurement' }
    },
    {
      params: { slug: 'rearsyte' },
      props: { appName: 'RearSyte', appIcon: '👁️', appType: 'Screen Privacy' }
    },
    {
      params: { slug: 'coven' },
      props: { appName: 'Coven', appIcon: '🚀', appType: 'Hardware-Attested Cohorts' }
    }
  ];
}

const { slug } = Astro.params;
const { appName, appIcon, appType } = Astro.props;

const seoTitle = `${appName} Privacy Policy | School and Stuff`;
const seoDescription = `Official Privacy Policy for ${appName} (${appType}) developed by School and Stuff.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <section class="legal-header">
    <div class="container text-center">
      <div class="legal-badge">{appIcon} {appName} Privacy Policy</div>
      <h1 class="page-title animate-fade-in">{appName} Privacy Policy</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        {slug === 'seer' ? 'Last updated: June 1, 2026' : (slug === 'geo' ? 'Last updated: July 28, 2026' : (slug === 'rearsyte' ? 'Last updated: August 5, 2026' : 'Last updated: August 17, 2026'))}
      </p>
    </div>
  </section>

  <section class="legal-content">
    <div class="container">
      <div class="content-wrapper prose animate-fade-in" style="animation-delay: 0.2s">
        
        {slug === 'seer' && (
          <div class="seer-policy">
            <h2>1. Introduction</h2>
            <p>
              At <strong>School and Stuff</strong> (the creators of Seer), we take your privacy and the security of your educational data seriously. This Privacy Policy explains how we collect, use, and protect your information when you use the Seer Exam Prediction and Simulation Platform.
            </p>

            <h2>2. Data We Collect</h2>
            <p>To provide our intelligent prediction engine, we collect:</p>
            <ul>
              <li><strong>Account Information:</strong> Name, email address, and institutional affiliation (for student pathways).</li>
              <li><strong>User-Generated Content:</strong> Course materials, PDFs, textbooks, and past questions you upload to the platform to generate Question Briefs.</li>
              <li><strong>Usage Data:</strong> Performance on simulated exams, time spent on questions, and progression metrics.</li>
            </ul>

            <h2>3. How We Use Your Data</h2>
            <p>We use your data strictly to improve your educational experience:</p>
            <ul>
              <li>To generate accurate and personalized exam predictions and simulations.</li>
              <li>To track your progress and provide detailed feedback on areas needing improvement.</li>
              <li>To maintain and improve the security of the platform.</li>
            </ul>
            <p>
              <em>Production Safeguard:</em> We <strong>never</strong> sell your personal data or uploaded educational materials to third parties.
            </p>

            <h2>4. Data Security & Storage</h2>
            <p>
              We employ enterprise-grade security measures to protect student data. All data transmitted between your device and our servers is encrypted using industry-standard TLS. Uploaded files are stored securely and are accessible only to your account or affiliated institution.
            </p>

            <h2>5. Account Deletion & Rights</h2>
            <p>
              You have the right to access, modify, or permanently delete your account and all associated data at any time. Visit our <a href="/delete-account">Account Deletion Page</a> for step-by-step instructions.
            </p>

            <h2>6. Contact Us</h2>
            <p>
              If you have questions regarding Seer’s privacy practices, contact us at <strong>privacy@school-and-stuff.me</strong>.
            </p>
          </div>
        )}

        {slug === 'geo' && (
          <div class="geo-policy">
            <div class="zero-data-banner">
              🎯 <strong>Zero Data Collection Guarantee:</strong> Geo does not collect, store, transmit, or process any personal or location data.
            </div>

            <h2>1. Introduction</h2>
            <p>
              <strong>Geo</strong> is a farm and area measurement application developed by School and Stuff. We believe utility software should respect user privacy completely.
            </p>

            <h2>2. Data Collection Policy</h2>
            <p>
              <strong>Geo collects NO data.</strong>
            </p>
            <ul>
              <li>No personal identification or contact details are collected.</li>
              <li>No user accounts or sign-ins are required.</li>
              <li>No measurement logs, field maps, or area calculations are stored on remote servers.</li>
            </ul>

            <h2>3. GPS Location Permissions</h2>
            <p>
              Geo requests access to your mobile device’s Location Services (GPS) strictly while using the app to compute field boundaries, surface area, and line perimeters. All GPS processing takes place <strong>entirely in real-time on your hardware</strong> and is never logged remotely or transmitted to third parties.
            </p>

            <h2>4. Third-Party Sharing</h2>
            <p>
              Because Geo collects zero data, we do not share, sell, or transmit any user data to advertisers, analytical tools, or data brokers.
            </p>

            <h2>5. Contact Us</h2>
            <p>
              For any questions regarding Geo’s privacy policy, please reach out to <strong>privacy@school-and-stuff.me</strong>.
            </p>
          </div>
        )}

        {slug === 'rearsyte' && (
          <div class="rearsyte-policy">
            <div class="zero-data-banner">
              🛡️ <strong>Zero-Trust, Zero-Network Architecture:</strong> RearSyte physically omits internet permissions (<code>android.permission.INTERNET</code>). 100% of processing happens on your local device.
            </div>

            <p>
              At RearSyte, we take your privacy with absolute seriousness. RearSyte is engineered from the ground up under a Zero-Trust, Zero-Network Architecture.
            </p>
            <p>
              We do not collect, store, transmit, sell, or share any personal data, camera feeds, facial images, or telemetry. Everything RearSyte does happens 100% on your local device.
            </p>

            <h2>1. Camera Access & Real-Time Processing</h2>
            <p>RearSyte requests access to your device’s front-facing camera solely to detect secondary viewers looking over your shoulder.</p>
            <ul>
              <li><strong>100% Local On-Device Processing:</strong> Camera frames are analyzed strictly in volatile memory (RAM) using on-device machine learning (Google ML Kit).</li>
              <li><strong>No Image Retention:</strong> Camera frames are evaluated in real time (frame-by-frame) and immediately overwritten and discarded.</li>
              <li><strong>No Biometrics Stored:</strong> RearSyte does not create, store, or recognize facial identities, biometric templates, or individual faces. It only measures basic head orientation angles and bounding box dimensions in real time.</li>
              <li><strong>No Recording:</strong> RearSyte cannot record video or take photos.</li>
            </ul>

            <h2>2. Zero-Network Architecture (No Internet Permission)</h2>
            <p>RearSyte physically omits the <code>android.permission.INTERNET</code> permission from its application manifest.</p>
            <ul>
              <li><strong>Physical Transmission Prevention:</strong> Because the app has no network access permissions, it is physically impossible for your camera feed, metadata, or app statistics to leave your Android device.</li>
              <li><strong>No External Servers:</strong> RearSyte operates with zero remote servers, zero cloud infrastructure, and zero web APIs.</li>
            </ul>

            <h2>3. Analytics, Tracking & Advertising</h2>
            <ul>
              <li><strong>No Analytics:</strong> We do not track app usage, crash reports, device identifiers, or user behavior.</li>
              <li><strong>No Advertising:</strong> RearSyte contains no ad networks, no tracking scripts, and no third-party SDKs.</li>
              <li><strong>No Advertising ID:</strong> RearSyte does not access your Android Advertising ID or device hardware IDs (IMEI, MAC Address).</li>
            </ul>

            <h2>4. In-App Purchases & Billing</h2>
            <p>
              RearSyte offers a 7-day free trial followed by a one-time lifetime license purchase ("buy our developers a cup of coffee").
            </p>
            <p>
              Purchases are processed entirely by the official Google Play Store application using local Android Inter-Process Communication (IPC). RearSyte never sees, stores, or handles your credit card details, billing address, or payment information. All transaction data is managed exclusively by Google Play under Google's Privacy Policy.
            </p>

            <h2>5. Children's Privacy</h2>
            <p>
              Because RearSyte does not collect any personal data whatsoever, it fully complies with the Children’s Online Privacy Protection Act (COPPA) and General Data Protection Regulation (GDPR). The app is safe for users of all ages.
            </p>

            <h2>6. Changes to This Privacy Policy</h2>
            <p>
              We may update our Privacy Policy from time to time. However, our core commitment to Zero-Network Architecture and Zero-Data Collection will never change. Any updates will be posted on this page.
            </p>

            <h2>7. Contact Us</h2>
            <p>
              If you have any questions or security concerns regarding this Privacy Policy, feel free to reach out to us at:
            </p>
            <p>
              Email: <a href="mailto:privacy@school-and-stuff.me">privacy@school-and-stuff.me</a><br />
              Developer Website: <a href="https://school-and-stuff.me">school-and-stuff.me</a>
            </p>
          </div>
        )}

        {slug === 'coven' && (
          <div class="coven-policy">
            <div class="zero-data-banner" style="background-color: #f0fdf4; border-left-color: #22c55e; color: #15803d;">
              🛡️ <strong>Third Millennium Software / Coven Platform Privacy Commitment:</strong> Effective Date: August 17, 2026.
            </div>

            <p>
              Coven Platform ("Coven", "we", "our", or "us"), developed and operated by Third Millennium Software, is committed to protecting your privacy. This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you use the Coven Android application and associated services (collectively, the "Platform").
            </p>
            <p>
              Please read this Privacy Policy carefully. By creating an account or using Coven, you agree to the collection and use of information in accordance with this policy.
            </p>

            <h2>1. Information We Collect</h2>
            <h3>A. Information You Provide Directly</h3>
            <ul>
              <li><strong>Account Credentials:</strong> Email address, chosen developer username, hashed passwords, and authentication tokens managed securely via Supabase Auth.</li>
              <li><strong>Developer & Application Metadata:</strong> Application names, Android package identifiers (e.g., <code>com.example.app</code>), Google Play Closed Track / Internal Test opt-in URLs, promotional codes, app descriptions, test instructions, and uploaded app icons.</li>
              <li><strong>Bug Reports & Community Feedback:</strong> Bug reproduction descriptions, tester reviews, feedback notes, and rating evaluations submitted within testing lounges and review queues.</li>
            </ul>

            <h3>B. Information Collected Automatically & Proof-of-Work Telemetry</h3>
            <ul>
              <li><strong>Proof-of-Work Screen Recordings:</strong> When you explicitly initiate an attestation session to test an assigned application, Coven records a timed screen capture (typically 30 seconds) of the target application in action.</li>
              <li><strong>Application Usage Attestation Data:</strong> Duration and foreground timestamps verifying active interaction with the designated test application.</li>
              <li><strong>Device & Attestation Identifiers:</strong> Device model, manufacturer, Android OS version, unique device fingerprint hash, and hardware integrity/attestation signals to prevent emulator fraud, botting, and sybil attacks.</li>
              <li><strong>Network & Diagnostic Data:</strong> IP address, internet connectivity status, and structured application error logs.</li>
              <li><strong>Push Notification Tokens:</strong> Firebase Cloud Messaging (FCM) registration tokens to deliver task notifications and status updates.</li>
            </ul>

            <h2>2. Android Permissions & Sensitive Data Declarations</h2>
            <p>In strict accordance with Google Play Developer Policies, below are the sensitive device capabilities Coven requests and the exact justifications for each:</p>

            <div class="table-responsive">
              <table class="coven-table" style="margin-bottom: var(--space-6);">
                <thead>
                  <tr>
                    <th>Permission</th>
                    <th>Technical Name</th>
                    <th>Purpose & Usage Justification</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Screen Recording / Media Projection</strong></td>
                    <td><code>FOREGROUND_SERVICE_MEDIA_PROJECTION</code></td>
                    <td>Used strictly and exclusively during user-initiated 30-second testing sessions to record video proof that the assigned app was tested on a genuine physical device. Recording only occurs after an explicit system consent prompt and displays an ongoing foreground notification. Coven never records in the background or outside active test sessions.</td>
                  </tr>
                  <tr>
                    <td><strong>Usage Access / App Statistics</strong></td>
                    <td><code>PACKAGE_USAGE_STATS</code></td>
                    <td>Used to cryptographically verify foreground testing duration (watchdog verification), proving that a tester actively spent the required time inside the developer's target application.</td>
                  </tr>
                  <tr>
                    <td><strong>Package Visibility / Query</strong></td>
                    <td><code>QUERY_ALL_PACKAGES</code></td>
                    <td>Used solely to verify whether the designated testing application is installed on your physical device before initiating testing tasks and cohort syncs.</td>
                  </tr>
                  <tr>
                    <td><strong>Push Notifications</strong></td>
                    <td><code>POST_NOTIFICATIONS</code></td>
                    <td>Used on Android 13+ to send real-time alerts regarding daily cohort testing deadlines, task review approvals, escrow releases, and dispute resolutions.</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <h2>3. How We Use Your Information</h2>
            <p>We use the collected information for the following operational, security, and verification purposes:</p>
            <ul>
              <li><strong>Automated Attestation & Proof of Work:</strong> To analyze and store screen recordings and usage metrics verifying legitimate testing of target apps.</li>
              <li><strong>Cohort Reciprocity & Task Marketplace:</strong> To coordinate 20-tester closed testing cohorts, match developers with testers, and manage task lifecycles.</li>
              <li><strong>Escrow & Virtual Economy Management:</strong> To calculate strike counts, reputation scores, track Coven Coin balances, lock escrow for posted tasks, and release rewards upon verified completion.</li>
              <li><strong>Anti-Fraud & Hardware Integrity:</strong> To enforce single-device limits per cohort, detect emulator farms, and ensure genuine physical Android hardware is utilized.</li>
              <li><strong>Customer Support & Dispute Resolution:</strong> To review contested submissions where developers or testers disagree on test validity.</li>
            </ul>

            <h2>4. Third-Party Services & Sub-Processors</h2>
            <p>We do not sell, rent, or trade your personal information. We share data only with the following trusted service providers necessary to operate the Platform:</p>
            <ul>
              <li><strong>Supabase, Inc. (Backend, Database & Storage):</strong> Hosts user authentication sessions, PostgreSQL database tables, and secure cloud storage for app icons and proof-of-work video submissions.</li>
              <li><strong>Google LLC (Firebase Cloud Messaging & Android OS):</strong> Provides push notification routing (FCM) and Android platform runtime attestation APIs.</li>
              <li><strong>DiceBear API:</strong> Used to render deterministic, auto-generated profile avatar artwork using anonymized name/email hash seeds.</li>
            </ul>

            <h2>5. Data Sharing Between Platform Users</h2>
            <ul>
              <li><strong>Between Testers and App Developers:</strong> When a tester completes an assigned test, the app developer receives the proof-of-work video recording, testing feedback, and verification timestamp to evaluate test quality.</li>
              <li><strong>Public/Cohort Visibility:</strong> Within a cohort or leaderboard, other verified cohort members can view your public developer name, verification streak, and completed test counts. Your password, private email, and device hardware hashes are never exposed to other users.</li>
            </ul>

            <h2>6. Data Retention & Account Deletion Policy</h2>
            <p>We retain your data only for as long as your account remains active or as needed to maintain platform attestation integrity:</p>
            <ul>
              <li><strong>Active Accounts:</strong> User profiles, app registration details, and coin balances are maintained while your account is active.</li>
              <li><strong>Test Video Proofs:</strong> Screen recording submissions are stored in cloud storage for developer verification and dispute windows, after which they may be purged according to storage lifecycle policies.</li>
              <li><strong>Account Deletion (Google Play Compliant):</strong> You can initiate account deletion at any time directly through the Coven Platform application under your Profile settings or visit our <a href="/delete-account">Account Deletion Page</a>. When requested, your account enters a scheduled deletion grace period (<code>scheduled_deletion_at</code>), after which all personal identifiers, auth records, active sessions, and registered apps are permanently erased or anonymized from our primary databases.</li>
            </ul>

            <h2>7. Security Safeguards</h2>
            <p>We implement industry-standard production safeguards to protect your personal information:</p>
            <ul>
              <li><strong>Encrypted Transmission:</strong> All network communications between Coven and our backend use TLS 1.3 encryption (HTTPS/WSS).</li>
              <li><strong>Hardware-Backed Protection:</strong> Device attestation uses secure Android KeyStore and OS-level signature verification.</li>
              <li><strong>Row-Level Security (RLS):</strong> Database records in Supabase are enforced with strict Row-Level Security policies, ensuring users can only read and mutate authorized records.</li>
            </ul>

            <h2>8. International Data Transfers & Children's Privacy</h2>
            <ul>
              <li><strong>International Transfers:</strong> Your data may be processed on servers located outside your home country. By using the platform, you consent to the transfer of information to jurisdictions where our cloud infrastructure providers operate.</li>
              <li><strong>Children's Privacy:</strong> Coven is designed exclusively for software developers and Android app testers aged 18 and older (or the age of majority in your jurisdiction). We do not knowingly collect personal data from children under 13 (or under 16 in the EU).</li>
            </ul>

            <h2>9. Your Rights (GDPR & CCPA / CPRA)</h2>
            <p>Depending on your geographic location, you may have the following rights regarding your personal information:</p>
            <ul>
              <li><strong>Right to Access / Portability:</strong> Request a copy of the personal data we maintain about you.</li>
              <li><strong>Right to Rectification:</strong> Request correction of inaccurate or incomplete information.</li>
              <li><strong>Right to Erasure / Deletion:</strong> Request the permanent deletion of your personal data.</li>
              <li><strong>Right to Withdraw Consent:</strong> Revoke permissions (such as Notifications or Usage Access) at any time via your Android device system settings.</li>
            </ul>
            <p>To exercise any of these rights, contact us using the information provided in Section 11.</p>

            <h2>10. Changes to This Privacy Policy</h2>
            <p>
              We may update this Privacy Policy periodically to reflect enhancements to our testing features, attestation mechanisms, or regulatory requirements. We will notify you of material changes by updating the "Last Updated" date at the top of this document and via in-app push notifications when appropriate.
            </p>

            <h2>11. Contact Us</h2>
            <p>
              If you have questions, concerns, or data protection inquiries regarding this Privacy Policy, please contact us at:
            </p>
            <p>
              <strong>Entity:</strong> Third Millennium Software / Coven Test Platform<br />
              <strong>Privacy Email:</strong> <a href="mailto:privacy@covenplatform.com">privacy@covenplatform.com</a><br />
              <strong>Developer Support:</strong> <a href="mailto:support@covenplatform.com">support@covenplatform.com</a><br />
              <strong>Developer Website:</strong> <a href="https://school-and-stuff.me">school-and-stuff.me</a>
            </p>
          </div>
        )}

        <div class="policy-nav-footer">
          <Button href="/privacy" variant="secondary">&larr; Back to All Privacy Policies</Button>
          <Button href="/privacy/rearsyte" variant="primary">View RearSyte Privacy Policy &rarr;</Button>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-header {
    padding: var(--space-8) 0 var(--space-4) 0;
    background-color: var(--brand-yellow-light);
    border-bottom: 1px solid var(--brand-yellow);
  }

  .text-center {
    text-align: center;
  }

  .legal-badge {
    display: inline-block;
    background: var(--bg-primary);
    color: var(--brand-yellow-darker);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: var(--space-1);
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-content {
    padding: var(--space-8) 0;
  }

  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .zero-data-banner {
    background-color: #e0f2fe;
    border-left: 4px solid #0284c7;
    color: #0369a1;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-6);
    font-size: 1.05rem;
  }

  .prose h2 {
    margin-top: var(--space-6);
    color: var(--text-primary);
    border-bottom: 2px solid var(--brand-yellow);
    display: inline-block;
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .prose p, .prose ul {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .prose ul {
    padding-left: var(--space-5);
  }

  .prose li {
    margin-bottom: var(--space-2);
  }

  .policy-nav-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid #e5e7eb;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
