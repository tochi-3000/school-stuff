---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

const title = "Privacy Policies | School and Stuff";
const description = "Select an application to view its privacy policy: Seer or Geo.";

const policies = [
  {
    slug: 'seer',
    name: 'Seer Privacy Policy',
    app: '🔮 Seer (Exam Simulation)',
    updated: 'June 1, 2026',
    description: 'Learn how Seer protects student data, course materials, uploaded PDFs, and exam performance metrics.',
    href: '/privacy/seer'
  },
  {
    slug: 'geo',
    name: 'Geo Privacy Policy',
    app: '🌐 Geo (Farm & Area Measurement)',
    updated: 'July 28, 2026',
    description: 'Geo features a Zero Data Collection guarantee. No location data or measurements leave your local device.',
    href: '/privacy/geo'
  },
  {
    slug: 'rearsyte',
    name: 'RearSyte Privacy Policy',
    app: '👁️ RearSyte (Screen Privacy)',
    updated: 'August 5, 2026',
    description: 'Zero-Trust, Zero-Network Architecture. No internet permissions, no data collection, no telemetry, and no video recording.',
    href: '/privacy/rearsyte'
  },
  {
    slug: 'coven',
    name: 'Coven Privacy Policy',
    app: '🚀 Coven (Hardware-Attested Cohorts)',
    updated: 'August 17, 2026',
    description: 'Covers Android KeyStore hardware attestation, MediaProjection 30s video proof-of-work, Coven Coins, and cohort data safety.',
    href: '/privacy/coven'
  }
];
---

<Layout title={title} description={description}>
  <section class="privacy-header">
    <div class="container text-center">
      <h1 class="page-title animate-fade-in">Privacy Policies</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        Select an application below to read its detailed privacy policy.
      </p>
    </div>
  </section>

  <section class="privacy-directory">
    <div class="container">
      <div class="policies-grid">
        {policies.map((policy, index) => (
          <article class="policy-card animate-fade-in" style={`animation-delay: ${0.2 + (index * 0.1)}s`}>
            <div class="policy-app">{policy.app}</div>
            <h2 class="policy-title">{policy.name}</h2>
            <span class="policy-updated">Last Updated: {policy.updated}</span>
            <p class="policy-desc">{policy.description}</p>
            <div class="policy-action">
              <Button href={policy.href} variant="primary">Read {policy.slug === 'seer' ? 'Seer' : 'Geo'} Privacy Policy &rarr;</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .privacy-header {
    padding: var(--space-8) 0 var(--space-6) 0;
    background-color: var(--brand-yellow-light);
    border-bottom: 1px solid var(--brand-yellow);
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
  }

  .privacy-directory {
    padding: var(--space-8) 0;
  }

  .policies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: var(--space-8);
  }

  .policy-card {
    background: var(--bg-primary);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .policy-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--brand-yellow);
  }

  .policy-app {
    font-weight: 700;
    color: var(--brand-yellow-darker);
    margin-bottom: var(--space-2);
  }

  .policy-title {
    font-size: 1.6rem;
    margin-bottom: var(--space-1);
  }

  .policy-updated {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);

  }

  .policy-desc {
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-6);
    flex-grow: 1;
  }

  .policy-action {
    margin-top: auto;
  }
</style>
