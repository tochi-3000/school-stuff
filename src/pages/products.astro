---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';

const title = "Our Products | School and Stuff";
const description = "Discover Seer (Exam Prediction & Simulation) and Geo (Farm & Area Measurement) by School and Stuff.";
---

<Layout title={title} description={description}>
  <!-- Page Header -->
  <section class="products-header">
    <div class="container text-center">
      <h1 class="page-title animate-fade-in">School & Stuff Products</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        Intelligent, reliable software designed to make learning and land management simple and effective.
      </p>
    </div>
  </section>

  <!-- Product 1: Seer -->
  <section id="seer" class="product-section">
    <div class="container">
      <div class="product-hero animate-fade-in">
        <div class="product-badge">EdTech & Exam Simulation</div>
        <h2>🔮 Seer: Exam Prediction & Simulation Platform</h2>
        <p class="product-desc">
          An intelligent engine that analyzes course syllabi and past questions to predict high-probability exam topics and generate custom simulation tests.
        </p>
        <div class="product-cta">
          <Button href="https://play.google.com/store/apps/details?id=com.seer.app" variant="primary" target="_blank" rel="noopener noreferrer">
            Download Seer on Google Play
          </Button>
        </div>
      </div>

      <div class="pathways-grid">
        <!-- Pathway 1: Independent Users -->
        <article class="pathway-card">
          <div class="pathway-header">
            <h3>1. Independent Users</h3>
            <span class="badge">Self-Guided</span>
          </div>
          <div class="pathway-body">
            <ol class="steps-list">
              <li>Upload your course PDF or textbook, along with past questions.</li>
              <li>We extract key terms and filter out noise into a <strong>"Question Brief"</strong>.</li>
              <li>Past questions are sorted into: <em>"Most Frequently Asked"</em>, <em>"Frequently Asked"</em>, and <em>"Rarely Asked"</em>.</li>
              <li>Generate <strong>300 exam questions</strong> to test your readiness in a real simulation environment.</li>
              <li>Receive detailed explanations for missed questions to improve before exam day.</li>
            </ol>
          </div>
        </article>

        <!-- Pathway 2: Students -->
        <article class="pathway-card">
          <div class="pathway-header">
            <h3>2. Students</h3>
            <span class="badge">School Affiliated</span>
          </div>
          <div class="pathway-body">
            <p class="intro-text">Joining Seer as a student is straightforward:</p>
            <ol class="steps-list">
              <li>Select "Student" during onboarding, select your institution, and pick your course.</li>
              <li>Access all pre-loaded course simulations directly on your student dashboard.</li>
              <li>Take unlimited exam simulations anytime.</li>
            </ol>
          </div>
        </article>
      </div>
    </div>
  </section>

  <hr class="section-divider" />

  <!-- Product 2: Geo -->
  <section id="geo" class="product-section geo-section">
    <div class="container">
      <div class="product-hero animate-fade-in">
        <div class="product-badge geo-badge">Land & Utility Tool</div>
        <h2>🌐 Geo: Farm & Area Measurement</h2>
        <p class="product-desc">
          A fast, lightweight, and high-precision farm and area measurement application designed for farmers, surveyors, and outdoor enthusiasts.
        </p>
      </div>

      <div class="geo-features-grid">
        <div class="geo-card">
          <div class="geo-icon">📍</div>
          <h3>GPS Area & Perimeter</h3>
          <p>Measure fields, farmland, property boundaries, and distances in real-time with GPS precision.</p>
        </div>

        <div class="geo-card">
          <div class="geo-icon">📐</div>
          <h3>Field & Land Mapping</h3>
          <p>Easily calculate plot dimensions and manage farm layout planning right from your mobile device.</p>
        </div>

        <div class="geo-card privacy-card">
          <div class="geo-icon">🔒</div>
          <h3>100% Private by Design</h3>
          <p><strong>Geo does not collect, store, or process user data.</strong> All your measurement logs and calculations stay entirely on your device.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .products-header {
    padding: var(--space-8) 0 var(--space-6) 0;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid #e5e7eb;
  }

  .text-center {
    text-align: center;
  }

  .page-title {
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 650px;
    margin: 0 auto;
  }

  .product-section {
    padding: var(--space-8) 0;
  }

  .section-divider {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 0;
  }

  .product-hero {
    max-width: 800px;
    margin: 0 auto var(--space-8) auto;
    text-align: center;
  }

  .product-badge {
    display: inline-block;
    background: var(--brand-yellow-light);
    color: var(--brand-yellow-darker);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .geo-badge {
    background: #e0f2fe;
    color: #0369a1;
  }

  .product-hero h2 {
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .product-desc {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: var(--space-4);
  }

  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .pathway-card {
    background: var(--bg-primary);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .pathway-header {
    background: var(--brand-yellow-light);
    padding: var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--brand-yellow);
  }

  .pathway-header h3 {
    margin: 0;
    font-size: 1.35rem;
    color: var(--text-primary);
  }

  .badge {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .pathway-body {
    padding: var(--space-4);
  }

  .intro-text {
    font-weight: 500;
    margin-bottom: var(--space-2);
  }

  .steps-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--text-secondary);
  }

  .steps-list li {
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }

  /* Geo styles */
  .geo-section {
    background-color: var(--bg-secondary);
  }

  .geo-features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .geo-card {
    background: var(--bg-primary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid #e5e7eb;
    box-shadow: var(--shadow-sm);
  }

  .geo-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-3);
  }

  .geo-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
    color: var(--text-primary);
  }

  .geo-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .privacy-card {
    border-left: 4px solid #0284c7;
  }
</style>
