---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'seer' },
      props: {
        product: {
          id: 'seer',
          name: 'Seer',
          title: 'Seer — Exam Prediction & Simulation Platform',
          tagline: 'An intelligent engine that helps students pass exams in flying colors.',
          badge: 'EdTech & Exam Simulation',
          icon: '🔮',
          description: 'Seer analyzes your course syllabi and past questions to predict high-probability exam topics, generate custom simulation tests, and build exam confidence.',
          playStoreUrl: 'https://play.google.com/store/apps/details?id=com.seer.app',
          privacyUrl: '/privacy/seer',
          termsUrl: '/terms/seer',
        }
      }
    },
    {
      params: { slug: 'geo' },
      props: {
        product: {
          id: 'geo',
          name: 'Geo',
          title: 'Geo — Farm & Area Measurement Application',
          tagline: 'A fast, lightweight, and high-precision farm and area measurement tool.',
          badge: 'Land & Utility Tool',
          icon: '🌐',
          description: 'Geo allows farmers, land surveyors, and outdoor enthusiasts to accurately measure land surface area, perimeter, and distances with real-time GPS precision.',
          privacyUrl: '/privacy/geo',
          termsUrl: '/terms/geo',
        }
      }
    },
    {
      params: { slug: 'rearsyte' },
      props: {
        product: {
          id: 'rearsyte',
          name: 'RearSyte',
          title: 'RearSyte — Screen Privacy & Anti-Shoulder Surfing',
          tagline: 'Protect your screen privacy with real-time on-device machine learning.',
          badge: 'Privacy & Security Tool',
          icon: '👁️',
          description: 'RearSyte detects when secondary viewers look over your shoulder at your screen using Google ML Kit. Engineered under a Zero-Trust, Zero-Network Architecture.',
          privacyUrl: '/privacy/rearsyte',
          termsUrl: '/terms/rearsyte',
        }
      }
    },
    {
      params: { slug: 'coven' },
      props: {
        product: {
          id: 'coven',
          name: 'Coven',
          title: 'Never Stress Over Google Play’s 20-Tester Rule Again',
          tagline: 'Coven is the native Android attestation platform that pairs indie developers into verified, automated testing cohorts. 14 days of real device testing, guaranteed proof of work, and zero ghosting.',
          badge: '100% Real Physical Devices • Hardware-Attested • Zero Emulators',
          icon: '🚀',
          description: 'Coven pairs indie developers into verified, automated testing cohorts. 14 days of real device testing, guaranteed proof of work, and zero ghosting.',
          privacyUrl: '/privacy/coven',
          termsUrl: '/terms/coven',
        }
      }
    }
  ];
}

const { product } = Astro.props;
const seoTitle = `${product.name} | School and Stuff`;
const seoDescription = product.description;
---

<Layout title={seoTitle} description={seoDescription}>
  <section class="product-header">
    <div class="container text-center">
      <div class="product-badge">{product.badge}</div>
      <h1 class="page-title animate-fade-in">{product.icon} {product.title}</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        {product.tagline}
      </p>
      
      {product.playStoreUrl && (
        <div class="header-cta animate-fade-in" style="animation-delay: 0.2s">
          <Button href={product.playStoreUrl} variant="primary" target="_blank" rel="noopener noreferrer">
            Download on Google Play
          </Button>
        </div>
      )}
    </div>
  </section>

  <section class="product-details">
    <div class="container">
      {product.id === 'seer' && (
        <div class="seer-details animate-fade-in">
          <div class="section-intro text-center">
            <h2>How Seer Works</h2>
            <p>Choose your pathway to get started with exam simulations.</p>
          </div>

          <div class="pathways-grid">
            <article class="pathway-card">
              <div class="pathway-header">
                <h3>1. Independent Users</h3>
                <span class="badge">Self-Guided</span>
              </div>
              <div class="pathway-body">
                <ol class="steps-list">
                  <li>Upload your course PDF or textbook, along with past questions.</li>
                  <li>We extract key terms and filter out noise into a <strong>"Question Brief"</strong>.</li>
                  <li>Past questions are sorted into: <em>"Most Frequently Asked"</em>, <em>"Frequently Asked"</em>, and <em>"Rarely Asked"</em>.</li>
                  <li>Generate <strong>300 exam questions</strong> to test your readiness in a real simulation environment.</li>
                  <li>Receive detailed explanations for missed questions to improve before exam day.</li>
                </ol>
              </div>
            </article>

            <article class="pathway-card">
              <div class="pathway-header">
                <h3>2. Students</h3>
                <span class="badge">School Affiliated</span>
              </div>
              <div class="pathway-body">
                <p class="intro-text">Joining Seer as a student is straightforward:</p>
                <ol class="steps-list">
                  <li>Select "Student" during onboarding, select your institution, and pick your course.</li>
                  <li>Access all pre-loaded course simulations directly on your student dashboard.</li>
                  <li>Take unlimited exam simulations anytime.</li>
                </ol>
              </div>
            </article>
          </div>
        </div>
      )}

      {product.id === 'geo' && (
        <div class="geo-details animate-fade-in">
          <div class="section-intro text-center">
            <h2>Key Capabilities of Geo</h2>
            <p>Designed for farmers, surveyors, and field workers who demand accuracy and zero data tracking.</p>
          </div>

          <div class="geo-grid">
            <div class="geo-card">
              <div class="geo-icon">📍</div>
              <h3>Real-Time GPS Precision</h3>
              <p>Walk boundaries or pin coordinates to calculate surface area, perimeter, and line distances directly on the field.</p>
            </div>

            <div class="geo-card">
              <div class="geo-icon">🚜</div>
              <h3>Farm & Field Mapping</h3>
              <p>Easily calculate plot dimensions, estimate crop yield areas, and plan irrigation layout boundaries.</p>
            </div>

            <div class="geo-card privacy-highlight">
              <div class="geo-icon">🔒</div>
              <h3>100% Private by Design</h3>
              <p><strong>Geo does not collect, store, or process user data.</strong> All your measurement logs and GPS calculations stay exclusively on your local device.</p>
            </div>
          </div>
        </div>
      )}

      {product.id === 'rearsyte' && (
        <div class="rearsyte-details animate-fade-in">
          <div class="section-intro text-center">
            <h2>Key Security Features of RearSyte</h2>
            <p>Engineered under a Zero-Trust, Zero-Network Architecture to guarantee absolute privacy.</p>
          </div>

          <div class="geo-grid">
            <div class="geo-card privacy-highlight">
              <div class="geo-icon">⚡</div>
              <h3>Zero-Network Architecture</h3>
              <p>Physically omits internet permissions (<code>INTERNET</code>). It is physically impossible for camera feeds or metadata to leave your Android device.</p>
            </div>

            <div class="geo-card">
              <div class="geo-icon">👁️</div>
              <h3>Real-Time On-Device ML</h3>
              <p>Camera frames are analyzed strictly in volatile memory (RAM) using Google ML Kit frame-by-frame, then immediately overwritten and discarded.</p>
            </div>

            <div class="geo-card">
              <div class="geo-icon">🔒</div>
              <h3>Zero Biometric Storage</h3>
              <p>No facial identities, biometric templates, photos, or video recordings are created, stored, or recognized. Only basic head orientation angles are evaluated.</p>
            </div>

            <div class="geo-card">
              <div class="geo-icon">☕</div>
              <h3>7-Day Trial & One-Time Purchase</h3>
              <p>Enjoy a 7-day free trial followed by a single one-time lifetime license purchase via Google Play Store. No recurring subscriptions.</p>
            </div>
          </div>
        </div>
      )}

      {product.id === 'coven' && (
        <div class="coven-details animate-fade-in">
          <!-- Problem Section -->
          <div class="coven-section problem-box">
            <h2 class="section-heading text-center">🛑 The 20-Tester Mandate Is Killing Indie Apps</h2>
            <p class="section-lead text-center">If you’ve tried to launch an Android app recently, you know the nightmare:</p>
            <div class="problem-grid">
              <div class="problem-card">
                <div class="problem-icon">👻</div>
                <h3>The Discord & Reddit Ghost Town</h3>
                <p>You swap links with 20 strangers. By Day 3, 18 of them stop opening your app.</p>
              </div>
              <div class="problem-card">
                <div class="problem-icon">❌</div>
                <h3>Google Play Rejections</h3>
                <p>Google tracks engagement. If testers don’t actually launch and use your app, production access gets denied after 14 wasted days.</p>
              </div>
              <div class="problem-card">
                <div class="problem-icon">💸</div>
                <h3>Overpriced "Tester Farms"</h3>
                <p>Shady agencies charge $100+ to run bots and emulators that Google’s automated review filters easily detect and flag.</p>
              </div>
            </div>
          </div>

          <!-- Solution Section -->
          <div class="coven-section solution-box">
            <h2 class="section-heading text-center">💡 Meet Coven: Attestation-Backed Reciprocal Testing</h2>
            <p class="section-lead text-center">
              Coven replaces informal favors with a cryptographically verified, peer-to-peer testing network.
            </p>
            <div class="solution-highlight text-center">
              <p>
                Every tester in your cohort is a fellow developer with skin in the game. When they test your app, Coven’s native capture engine proves they launched it on real physical hardware, interacted with it, and submitted actionable feedback.
              </p>
            </div>
          </div>

          <!-- How It Works Section -->
          <div class="coven-section steps-box">
            <h2 class="section-heading text-center">⚙️ How It Works — 4 Easy Steps</h2>
            <div class="coven-steps-grid">
              <div class="step-card">
                <div class="step-num">1</div>
                <h3>Register Your App</h3>
                <p>Add your Google Play Closed Track link, test credentials, and testing goals in 60 seconds.</p>
              </div>
              <div class="step-card">
                <div class="step-num">2</div>
                <h3>Lock Your Slot in a 20-Dev Cohort</h3>
                <p>Join a synchronized testing circle. Everyone agrees to test each other’s apps daily throughout the 14-day cycle.</p>
              </div>
              <div class="step-card">
                <div class="step-num">3</div>
                <h3>Perform 30-Second Attested Tests</h3>
                <p>Launch assigned daily apps directly through Coven. Our native engine records a verified 30-second screen capture session and monitors foreground usage.</p>
              </div>
              <div class="step-card">
                <div class="step-num">4</div>
                <h3>Unlock Production Access</h3>
                <p>Receive real bug reports, continuous daily analytics, and verified proof of work that satisfies Google Play’s engagement algorithms.</p>
              </div>
            </div>
          </div>

          <!-- Core Features Table -->
          <div class="coven-section features-table-box">
            <h2 class="section-heading text-center">🛡️ Core Features & Differentiators</h2>
            <div class="table-responsive">
              <table class="coven-table">
                <thead>
                  <tr>
                    <th>Feature</th>
                    <th>What It Does</th>
                    <th>Why You’ll Love It</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>🔒 Hardware Attestation</strong></td>
                    <td>Verifies physical Android device integrity and OS signatures via Android KeyStore.</td>
                    <td>Zero bots. Zero emulator farms. 100% genuine Android hardware.</td>
                  </tr>
                  <tr>
                    <td><strong>📹 Automated Proof of Work</strong></td>
                    <td>Captures a 30s native video proof and validates active foreground time.</td>
                    <td>You see video proof of your app running on different screen sizes and OS versions.</td>
                  </tr>
                  <tr>
                    <td><strong>🤝 Cohort Accountability & Strikes</strong></td>
                    <td>Enforces daily reciprocity. Testers who miss days receive strikes and get evicted.</td>
                    <td>Eliminates ghosting. Everyone tests so their own app gets tested.</td>
                  </tr>
                  <tr>
                    <td><strong>⚡ Task Marketplace</strong></td>
                    <td>Need extra testers fast? Post bounty tasks funded with in-app Coven Coins.</td>
                    <td>Scale your testing pool beyond cohorts whenever you need quick feedback.</td>
                  </tr>
                  <tr>
                    <td><strong>🌍 13 Built-in Languages</strong></td>
                    <td>Full global localization across English, Spanish, French, German, Japanese, Chinese, Arabic, and more.</td>
                    <td>Connect with a diverse, international pool of beta testers across global markets.</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Comparison Table -->
          <div class="coven-section comparison-box">
            <h2 class="section-heading text-center">📊 Why Developers Choose Coven</h2>
            <div class="table-responsive">
              <table class="coven-table comparison-table">
                <thead>
                  <tr>
                    <th>Criteria</th>
                    <th>Reddit / Discord Swaps</th>
                    <th>Paid "Tester Farms"</th>
                    <th>Coven Platform</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Real Physical Devices</strong></td>
                    <td class="badge-neutral">❓ Unknown</td>
                    <td class="badge-bad">❌ Emulators / Bots</td>
                    <td class="badge-good">✅ 100% Attested Hardware</td>
                  </tr>
                  <tr>
                    <td><strong>Engagement Verification</strong></td>
                    <td class="badge-bad">❌ None (Honor system)</td>
                    <td class="badge-bad">❌ Fake clicks</td>
                    <td class="badge-good">✅ 30s Video Proof + Telemetry</td>
                  </tr>
                  <tr>
                    <td><strong>14-Day Completion Rate</strong></td>
                    <td class="badge-bad">📉 Less than 15%</td>
                    <td class="badge-warn">⚠️ High ban risk</td>
                    <td class="badge-good">📈 98%+ Cohort Retention</td>
                  </tr>
                  <tr>
                    <td><strong>Actionable Bug Reports</strong></td>
                    <td class="badge-bad">❌ Rare</td>
                    <td class="badge-bad">❌ Generic text</td>
                    <td class="badge-good">✅ In-Depth Video Reproduction</td>
                  </tr>
                  <tr>
                    <td><strong>Cost</strong></td>
                    <td>Free (High time cost)</td>
                    <td>💰 $80 – $250</td>
                    <td class="badge-good">✨ 100% Free via Reciprocity</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- FAQ Section -->
          <div class="coven-section faq-box">
            <h2 class="section-heading text-center">💬 Frequently Asked Questions</h2>
            <div class="faq-grid">
              <div class="faq-card">
                <h3>Q: Is Coven compliant with Google Play policies?</h3>
                <p>A: Yes. Coven is not an incentivized review platform or rating scheme. It is a genuine developer beta-testing community. Testers download your app directly through official Google Play Closed Testing tracks and test on physical devices, which directly aligns with Google’s requirement for authentic pre-launch testing.</p>
              </div>
              <div class="faq-card">
                <h3>Q: How does the 30-second screen capture work?</h3>
                <p>A: When you begin an assigned test session, Coven requests one-time MediaProjection consent to record a 30-second clip of you interacting with the target app. The video is securely uploaded to the app developer as proof of work. Coven never records outside of active testing sessions.</p>
              </div>
              <div class="faq-card">
                <h3>Q: What happens if someone in my cohort stops testing?</h3>
                <p>A: Coven’s automated strike system flags inactive members. If a member misses testing deadlines, they receive strikes, forfeit their coin stake, and are hot-swapped with eager standby testers so your app never loses its required tester count.</p>
              </div>
              <div class="faq-card">
                <h3>Q: Do I have to pay to use Coven?</h3>
                <p>A: No. Coven operates on a reciprocal model. By testing other developers’ apps, you earn Coven Coins and cohort credits to have your own app tested completely free.</p>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Link to Legal Policies -->
      <div class="legal-links-box">
        <h3>Legal & Privacy for {product.name}</h3>
        <div class="legal-buttons">
          <Button href={product.privacyUrl} variant="secondary">View {product.name} Privacy Policy</Button>
          <Button href={product.termsUrl} variant="secondary">View {product.name} Terms of Service</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .product-header {
    padding: var(--space-8) 0 var(--space-6) 0;
    background-color: var(--bg-secondary);
    border-bottom: 1px solid #e5e7eb;
  }

  .text-center {
    text-align: center;
  }

  .product-badge {
    display: inline-block;
    background: var(--brand-yellow-light);
    color: var(--brand-yellow-darker);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .page-title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    margin-bottom: var(--space-2);
  }

  .page-subtitle {
    font-size: 1.2rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto var(--space-4) auto;
  }

  .header-cta {
    margin-top: var(--space-4);
  }

  .product-details {
    padding: var(--space-8) 0;
  }

  .section-intro {
    max-width: 650px;
    margin: 0 auto var(--space-8) auto;
  }

  .section-intro h2 {
    font-size: 2.2rem;
    color: var(--brand-yellow-darker);
  }

  .pathways-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .pathway-card {
    background: var(--bg-primary);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .pathway-header {
    background: var(--brand-yellow-light);
    padding: var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--brand-yellow);
  }

  .badge {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
  }

  .pathway-body {
    padding: var(--space-4);
  }

  .steps-list {
    margin: 0;
    padding-left: var(--space-4);
    color: var(--text-secondary);
  }

  .steps-list li {
    margin-bottom: var(--space-2);
    line-height: 1.6;
  }

  /* Geo specific grid */
  .geo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .geo-card {
    background: var(--bg-primary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid #e5e7eb;
    box-shadow: var(--shadow-sm);
  }

  .geo-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-3);
  }

  .geo-card h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .geo-card p {
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .privacy-highlight {
    border-left: 4px solid #0284c7;
    background: #f0f9ff;
  }

  .legal-links-box {
    background: var(--bg-secondary);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    text-align: center;
    border: 1px solid #e5e7eb;
    margin-top: var(--space-6);
  }

  .legal-links-box h3 {
    margin-bottom: var(--space-4);
  }

  .legal-buttons {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* Coven Specific Landing Page Styles */
  .coven-section {
    margin-bottom: var(--space-12);
  }

  .section-heading {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .section-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
  }

  .problem-grid, .coven-steps-grid, .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .problem-card, .step-card, .faq-card {
    background: var(--bg-primary);
    border: 1px solid #e5e7eb;
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    box-shadow: var(--shadow-sm);
  }

  .problem-card {
    border-top: 4px solid #ef4444;
  }

  .problem-icon {
    font-size: 2.2rem;
    margin-bottom: var(--space-2);
  }

  .solution-box {
    background: linear-gradient(135deg, var(--brand-yellow-light) 0%, var(--bg-primary) 100%);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--brand-yellow);
  }

  .solution-highlight p {
    font-size: 1.2rem;
    line-height: 1.8;
    color: var(--text-primary);
    max-width: 800px;
    margin: 0 auto;
  }

  .step-card {
    position: relative;
  }

  .step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    background: var(--brand-yellow);
    color: var(--text-primary);
    font-weight: 800;
    border-radius: var(--radius-full);
    margin-bottom: var(--space-3);
  }

  .table-responsive {
    overflow-x: auto;
  }

  .coven-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-primary);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    border: 1px solid #e5e7eb;
  }

  .coven-table th {
    background: var(--brand-yellow-light);
    color: var(--text-primary);
    padding: var(--space-4);
    text-align: left;
    font-weight: 700;
    border-bottom: 2px solid var(--brand-yellow);
  }

  .coven-table td {
    padding: var(--space-4);
    border-bottom: 1px solid #e5e7eb;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .coven-table tr:last-child td {
    border-bottom: none;
  }

  .badge-good {
    color: #15803d;
    font-weight: 700;
  }

  .badge-bad {
    color: #b91c1c;
  }

  .badge-warn {
    color: #b45309;
  }

  .badge-neutral {
    color: var(--text-secondary);
  }

  .faq-card h3 {
    font-size: 1.15rem;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .faq-card p {
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
