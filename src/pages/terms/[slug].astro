---
import Layout from '../../layouts/Layout.astro';
import Button from '../../components/Button.astro';

export function getStaticPaths() {
  return [
    {
      params: { slug: 'seer' },
      props: { appName: 'Seer', appIcon: '🔮', appType: 'Exam Simulation' }
    },
    {
      params: { slug: 'geo' },
      props: { appName: 'Geo', appIcon: '🌐', appType: 'Farm & Area Measurement' }
    },
    {
      params: { slug: 'rearsyte' },
      props: { appName: 'RearSyte', appIcon: '👁️', appType: 'Screen Privacy' }
    },
    {
      params: { slug: 'coven' },
      props: { appName: 'Coven', appIcon: '🚀', appType: 'Hardware-Attested Cohorts' }
    }
  ];
}

const { slug } = Astro.params;
const { appName, appIcon, appType } = Astro.props;

const seoTitle = `${appName} Terms of Service | School and Stuff`;
const seoDescription = `Official Terms of Service for ${appName} (${appType}) developed by School and Stuff.`;
---

<Layout title={seoTitle} description={seoDescription}>
  <section class="legal-header">
    <div class="container text-center">
      <div class="legal-badge">{appIcon} {appName} Terms of Service</div>
      <h1 class="page-title animate-fade-in">{appName} Terms of Service</h1>
      <p class="page-subtitle animate-fade-in" style="animation-delay: 0.1s">
        {slug === 'seer' ? 'Last updated: June 1, 2026' : (slug === 'geo' ? 'Last updated: July 28, 2026' : (slug === 'rearsyte' ? 'Last updated: August 5, 2026' : 'Last updated: August 17, 2026'))}
      </p>
    </div>
  </section>

  <section class="legal-content">
    <div class="container">
      <div class="content-wrapper prose animate-fade-in" style="animation-delay: 0.2s">
        
        {slug === 'seer' && (
          <div class="seer-terms">
            <h2>1. Acceptance of Terms</h2>
            <p>
              By accessing or using the Seer Exam Prediction and Simulation Platform developed by School and Stuff, you agree to be bound by these Terms of Service.
            </p>

            <h2>2. Use of the Service</h2>
            <p>
              Seer provides an intelligent prediction engine to simulate academic exams based on uploaded materials. You agree to use the Service solely for personal or institutional educational purposes.
            </p>
            <ul>
              <li><strong>No Guarantee of Academic Success:</strong> Seer categorizes questions by probability ("Most Frequently Asked", etc.), but we do not guarantee specific exam questions or passing grades. Seer is a study aid, not a replacement for studying your course materials.</li>
              <li><strong>Lawful Use:</strong> You may only upload course materials (PDFs, past questions) that you have the lawful right to use and share. Do not upload materials that violate intellectual property rights.</li>
            </ul>

            <h2>3. Intellectual Property</h2>
            <p>
              Seer software, algorithms, and design are the exclusive property of School and Stuff. Uploaded course materials remain your property.
            </p>

            <h2>4. Limitation of Liability</h2>
            <p>
              In no event shall School and Stuff be liable for any indirect or consequential academic outcomes or data loss arising from your use of Seer.
            </p>

            <h2>5. Contact</h2>
            <p>
              For questions regarding Seer’s Terms of Service, contact <strong>legal@school-and-stuff.me</strong>.
            </p>
          </div>
        )}

        {slug === 'geo' && (
          <div class="geo-terms">
            <h2>1. Acceptance of Terms</h2>
            <p>
              By installing or using <strong>Geo</strong> (Farm & Area Measurement Application) developed by School and Stuff, you agree to these Terms of Service.
            </p>

            <h2>2. App Functionality & Scope</h2>
            <p>
              Geo is designed as a portable field utility to estimate land surface area, perimeter, and distances using your device's built-in GPS location hardware.
            </p>

            <h2>3. GPS Accuracy Disclaimer</h2>
            <p>
              Measurement results depend directly on your device’s GPS hardware quality, satellite signal availability, and environmental conditions. 
            </p>
            <ul>
              <li>Geo is provided as an estimation and planning aid for farming, field layout, and general land measurement.</li>
              <li>Geo is <strong>not a certified legal land survey tool</strong> and should not be relied upon for official property boundary litigation or legal deeds.</li>
            </ul>

            <h2>4. Limitation of Liability</h2>
            <p>
              Because Geo operates strictly offline/locally and collects zero data, School and Stuff provides the app "as is" and shall not be held liable for any inaccuracies, land boundary disputes, or damages resulting from measurements made using the application.
            </p>

            <h2>5. Intellectual Property</h2>
            <p>
              The Geo application code, name, icon, and branding belong exclusively to School and Stuff.
            </p>

            <h2>6. Contact</h2>
            <p>
              For questions regarding Geo’s Terms of Service, contact <strong>legal@school-and-stuff.me</strong>.
            </p>
          </div>
        )}

        {slug === 'rearsyte' && (
          <div class="rearsyte-terms">
            <p>
              Welcome to RearSyte. Please read these Terms of Service ("Terms", "Agreement") carefully before installing, accessing, or using the RearSyte mobile application ("App", "Service") operated by the developers of RearSyte ("we", "us", "our").
            </p>
            <p>
              By downloading, installing, or using RearSyte, you agree to be bound by these Terms. If you do not agree to all of these Terms, do not install or use the App.
            </p>

            <h2>1. License Grant</h2>
            <p>
              Subject to your compliance with these Terms, we grant you a limited, personal, non-exclusive, non-transferable, non-sublicensable, revocable license to download, install, and use RearSyte on your compatible Android device for your personal, non-commercial privacy protection.
            </p>

            <h2>2. Free Trial & Payment Terms</h2>
            <ul>
              <li><strong>7-Day Free Trial:</strong> RearSyte provides a 7-day free trial starting upon initial installation.</li>
              <li><strong>Lifetime License:</strong> Following the expiration of the 7-day trial period, continued access to the App requires a one-time lifetime license purchase ("buy our developers a cup of coffee") processed through Google Play In-App Purchases.</li>
              <li><strong>No Subscriptions:</strong> The license is a one-time purchase with no recurring monthly or annual subscription fees. All transactions are final and subject to Google Play Refund Policies.</li>
            </ul>

            <h2>3. Restrictions on Use & Modification (Strictly Prohibited)</h2>
            <p>You agree that you will not, and will not permit or assist any third party to:</p>
            <ul>
              <li><strong>Modify the Application:</strong> Alter, modify, adapt, translate, patch, or create derivative works of RearSyte, its source code, compiled binaries, or user interface without our express prior written consent.</li>
              <li><strong>Reverse Engineering:</strong> Decompile, disassemble, reverse engineer, decrypt, or attempt to derive or extract the source code, underlying algorithms, or security mechanisms of the App.</li>
              <li><strong>Bypass Security & Billing Controls:</strong> Hack, bypass, disable, tamper with, or circumvent any license verification, high-water mark timestamp checks, 7-day trial counters, or security features built into the App.</li>
              <li><strong>Unauthorized Redistribution:</strong> Sell, rent, lease, sublicense, distribute, broadcast, upload to third-party app stores, or otherwise transfer or share the App (or any modified APKs/AABs) to any third party.</li>
              <li><strong>Malicious Use:</strong> Use RearSyte for any illegal, unauthorized, or unethical purpose under applicable local, national, or international laws.</li>
            </ul>
            <p>
              <em>Violation of any restriction in this section will result in immediate and automatic revocation of your license and may expose you to civil and criminal legal remedies.</em>
            </p>

            <h2>4. Intellectual Property Rights</h2>
            <p>
              The RearSyte application, including but not limited to its name, branding, logos, visual interface, graphics, user interface design, compiled code, machine learning pipeline architecture, and documentation, is the exclusive intellectual property of the developers and is protected by copyright, trademark, and other intellectual property laws.
            </p>

            <h2>5. Disclaimer of Warranties</h2>
            <p>
              <strong>REARSYTE IS PROVIDED ON AN "AS IS" AND "AS AVAILABLE" BASIS WITHOUT WARRANTIES OF ANY KIND, EITHER EXPRESS OR IMPLIED.</strong>
            </p>
            <p>
              While RearSyte utilizes on-device machine learning to detect shoulder surfers and secondary viewers, we do not guarantee 100% detection accuracy under all lighting, environmental, or spatial conditions. RearSyte is a privacy assistance utility and should not replace reasonable physical discretion when displaying sensitive data in public spaces.
            </p>

            <h2>6. Limitation of Liability</h2>
            <p>
              TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, IN NO EVENT SHALL THE DEVELOPERS OF REARSYTE BE LIABLE FOR ANY INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, INCLUDING BUT NOT LIMITED TO LOSS OF DATA, UNAUTHORIZED PHYSICAL OVER-THE-SHOULDER VIEWING BY THIRD PARTIES, OR DEVICE INCOMPATIBILITY ARISING OUT OF OR IN CONNECTION WITH YOUR USE OF OR INABILITY TO USE THE APP.
            </p>

            <h2>7. Termination</h2>
            <p>
              We reserve the right to revoke your license and terminate access to the App immediately, without prior notice or liability, if you breach any provision of these Terms.
            </p>

            <h2>8. Changes to These Terms</h2>
            <p>
              We reserve the right to modify these Terms at any time. Updated versions will be posted within the App or on our official store listing page. Continued use of RearSyte after any changes constitutes your acceptance of the new Terms.
            </p>

            <h2>9. Contact Us</h2>
            <p>
              If you have any questions regarding these Terms of Service or wish to request consent for legitimate developer partnerships, please contact us at:
            </p>
            <p>
              Email: <a href="mailto:legal@school-and-stuff.me">legal@school-and-stuff.me</a><br />
              Developer Website: <a href="https://school-and-stuff.me">school-and-stuff.me</a>
            </p>
          </div>
        )}

        {slug === 'coven' && (
          <div class="coven-terms">
            <div class="zero-data-banner" style="background-color: #f0fdf4; border-left-color: #22c55e; color: #15803d;">
              📜 <strong>Third Millennium Software / Coven Platform Terms:</strong> Effective Date: August 17, 2026.
            </div>

            <p>
              Welcome to Coven Platform ("Coven", "Platform", "we", "us", or "our"), operated by Third Millennium Software. These Terms of Service ("Terms") govern your access to and use of our native Android application, services, and associated platform.
            </p>
            <p>
              By creating an account, registering an application, joining a cohort, or accepting testing tasks, you agree to be bound by these Terms. If you do not agree to these Terms, you may not use the Platform.
            </p>

            <h2>1. Eligibility & Account Security</h2>
            <ul>
              <li><strong>Age Requirement:</strong> You must be at least 18 years old (or the age of majority in your jurisdiction) to use Coven.</li>
              <li><strong>One Physical Device & Account:</strong> To maintain testing integrity, each user is permitted one primary account. Multi-accounting, emulator farms, and virtual device spoofing are strictly prohibited.</li>
              <li><strong>Credential Protection:</strong> You are responsible for safeguarding your login credentials. You agree to notify us immediately of any unauthorized access to your account.</li>
            </ul>

            <h2>2. Platform Overview & Services</h2>
            <p>
              Coven is a peer-to-peer Android attestation and reciprocal testing platform designed to help mobile developers satisfy testing mandates (including Google Play’s 20-tester / 14-day closed testing requirements) through genuine, physically verified device testing.
            </p>
            <ul>
              <li><strong>Testing Cohorts:</strong> Structured groups of developers who mutually test each other’s applications daily over a designated cycle.</li>
              <li><strong>Task Marketplace:</strong> An open task board where developers post standalone testing missions and testers earn virtual platform rewards upon verified completion.</li>
              <li><strong>Automated Proof of Work:</strong> Native recording of timed testing sessions and background usage duration validation to verify genuine human engagement.</li>
            </ul>

            <h2>3. Developer Guidelines & App Submissions</h2>
            <p>When registering an application or posting a task on Coven:</p>
            <ul>
              <li><strong>Lawful Content Only:</strong> You may only submit apps, closed-track opt-in links, and promo codes for software that you own or are legally authorized to distribute. You may not submit apps containing malware, spyware, phishing mechanisms, copyright-infringing content, or material violating Google Play Developer Policies.</li>
              <li><strong>Accurate Information:</strong> You must provide working Google Play opt-in URLs, clear testing goals, and valid demo/test credentials if login is required.</li>
              <li><strong>Escrow Funding:</strong> When publishing paid testing tasks, required Coven Coins are locked in escrow upfront and released to testers upon verified completion or manual approval.</li>
              <li><strong>Prompt Submission Reviews:</strong> Developers agree to review submitted tester proofs within the designated review window. Submissions not reviewed within the grace period will automatically be approved by the system.</li>
            </ul>

            <h2>4. Tester Obligations & Proof-of-Work Standards</h2>
            <p>When accepting testing assignments:</p>
            <ul>
              <li><strong>Genuine Physical Device Testing:</strong> All tests must be executed on a physical Android device. Use of headless emulators, bot scripts, or modified runtimes to simulate engagement is a material breach of these Terms resulting in immediate account termination.</li>
              <li><strong>Proof-of-Work Compliance:</strong> You agree to grant the necessary temporary permissions (including MediaProjection screen recording and Usage Access) to generate verifiable video and telemetry proof of your test sessions.</li>
              <li><strong>Cohort Reciprocity & Strike Policy:</strong> Cohort participants must complete their assigned daily tests on time. Unexcused missed sessions or fraudulent submissions result in Strikes. Accumulating the maximum strike threshold results in forfeiture of staked slots and eviction from the active cohort.</li>
            </ul>

            <h2>5. Virtual Economy & Coven Coins</h2>
            <ul>
              <li><strong>In-App Utility Only:</strong> "Coven Coins" are virtual utility tokens designed exclusively to track participation, stake cohort slots, fund task escrows, and incentivize community testing within the Platform.</li>
              <li><strong>No Real-World Monetary Value:</strong> Coven Coins do not constitute real currency, property, or financial instruments. Coins cannot be redeemed, sold, or exchanged for fiat currency or monetary consideration outside the Platform.</li>
              <li><strong>Escrow Governance:</strong> In the event of a disputed test submission, platform administrators or automated attestation logs serve as the final authority on escrow release.</li>
            </ul>

            <h2>6. Intellectual Property Rights</h2>
            <ul>
              <li><strong>Developer Ownership:</strong> Developers retain all intellectual property rights, copyrights, and trade secrets in their submitted applications. Coven claims no ownership over your apps.</li>
              <li><strong>License to Testing Telemetry:</strong> By submitting screen recording proofs, bug descriptions, and feedback, testers grant Coven and the respective app developer a non-exclusive, worldwide, royalty-free license to use, review, and store the recording and feedback solely for testing verification, bug diagnosis, and dispute resolution.</li>
            </ul>

            <h2>7. Independent Platform & Google Play Disclaimer</h2>
            <ul>
              <li><strong>Independent Tool:</strong> Coven Platform is an independent developer tool and is not endorsed by, affiliated with, or sponsored by Google LLC or Alphabet Inc.</li>
              <li><strong>No Approval Guarantee:</strong> Coven guarantees that verified testers will test your application on genuine Android devices. However, Coven does not and cannot guarantee that Google will approve your app for production release, as Google Play production access decisions remain at the sole discretion of Google’s review teams.</li>
            </ul>

            <h2>8. Prohibited Conduct</h2>
            <p>You agree not to:</p>
            <ul>
              <li>Bypass, disable, or tamper with Coven’s hardware attestation, usage tracking, or screen capture verification services.</li>
              <li>Coordinate artificial reviews, rate-tampering, or fraudulent dispute filings.</li>
              <li>Reverse engineer, decompile, or disassemble any part of Coven's native capture engine.</li>
              <li>Harass, threaten, or abuse other developers or testers in cohort lounges or bug report channels.</li>
            </ul>

            <h2>9. Account Deletion & Termination</h2>
            <ul>
              <li><strong>Termination by You:</strong> You may delete your account at any time via the in-app Profile screen or visit our <a href="/delete-account">Account Deletion Page</a>. Upon initiation, your account enters a scheduled deletion grace period, after which your personal data is permanently purged.</li>
              <li><strong>Suspension / Termination by Coven:</strong> We reserve the right to suspend or terminate accounts that engage in fraud, emulator spoofing, malicious app distribution, or repeated cohort non-compliance without prior notice.</li>
            </ul>

            <h2>10. Limitation of Liability & Indemnification</h2>
            <p>
              TO THE MAXIMUM EXTENT PERMITTED BY APPLICABLE LAW, COVEN AND THIRD MILLENNIUM SOFTWARE SHALL NOT BE LIABLE FOR ANY INDIRECT, INCIDENTAL, PUNITIVE, OR CONSEQUENTIAL DAMAGES RESULTING FROM YOUR USE OF THE PLATFORM, THIRD-PARTY APPS TESTED, OR GOOGLE PLAY STORE POLICY ENFORCEMENT. YOU AGREE TO DEFEND, INDEMNIFY, AND HOLD HARMLESS COVEN FROM ANY CLAIMS ARISING OUT OF YOUR BREACH OF THESE TERMS OR THE CONTENT OF APPS YOU DISTRIBUTE.
            </p>

            <h2>11. Governing Law & Contact</h2>
            <p>
              These Terms are governed by and construed under the laws of the applicable jurisdiction without regard to conflict of law principles.
            </p>
            <p>
              <strong>Entity:</strong> Third Millennium Software / Coven Test Platform<br />
              <strong>Legal & Support Email:</strong> <a href="mailto:legal@covenplatform.com">legal@covenplatform.com</a><br />
              <strong>Developer Website:</strong> <a href="https://school-and-stuff.me">school-and-stuff.me</a>
            </p>
          </div>
        )}

        <div class="terms-nav-footer">
          <Button href="/terms" variant="secondary">&larr; Back to All Terms of Service</Button>
          <Button href="/terms/rearsyte" variant="primary">View RearSyte Terms of Service &rarr;</Button>
        </div>

      </div>
    </div>
  </section>
</Layout>

<style>
  .legal-header {
    padding: var(--space-8) 0 var(--space-4) 0;
    background-color: var(--brand-yellow-light);
    border-bottom: 1px solid var(--brand-yellow);
  }

  .text-center {
    text-align: center;
  }

  .legal-badge {
    display: inline-block;
    background: var(--bg-primary);
    color: var(--brand-yellow-darker);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .page-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    margin-bottom: var(--space-1);
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .legal-content {
    padding: var(--space-8) 0;
  }

  .content-wrapper {
    max-width: 800px;
    margin: 0 auto;
  }

  .prose h2 {
    margin-top: var(--space-6);
    color: var(--text-primary);
    border-bottom: 2px solid var(--brand-yellow);
    display: inline-block;
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
  }

  .prose p, .prose ul {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
  }

  .prose ul {
    padding-left: var(--space-5);
  }

  .prose li {
    margin-bottom: var(--space-2);
  }

  .terms-nav-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid #e5e7eb;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
</style>
